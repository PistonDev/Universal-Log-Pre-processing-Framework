{
    "patterns": [
        {
            "name": "RFC 3164",
            "priority": 1,
            "regex": "^(?P<timestamp>[A-Z][a-z]{2}\\s+\\d{1,2}\\s+\\d{2}:\\d{2}:\\d{2})\\s+(?P<host>\\S+)\\s+(?P<component>[^\\[:]+)(?:\\[(?P<pid>\\d+)\\])?:\\s+(?P<message>.*)$"
        },
        {
            "name": "RFC 5424",
            "priority": 2,
            "regex": "^<(?P<priority>\\d{1,3})>\\s*(?P<version>\\d+)\\s+(?P<timestamp>\\S+)\\s+(?P<host>\\S+)\\s+(?P<app>\\S+)\\s+(?P<pid>\\S+)\\s+(?P<msgid>\\S+)\\s+(?P<structured_data>-|\\[.*?\\])(?:\\s+(?P<message>.*))?$"
        }
    ]
}