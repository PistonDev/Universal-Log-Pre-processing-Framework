{
    "patterns": [
        {
            "name": "error log",
            "priority": 1,
            "regex": "^\\[(?P<timestamp>[^\\]]+)\\]\\s+\\[(?P<level>[^\\]]+)\\]\\s+(?P<message>.*)$"
        },
        {
            "name": "access log",
            "priority": 2,
            "regex": "^(?P<ip>\\S+)\\s+(?P<identity>\\S+)\\s+(?P<user>\\S+)\\s+\\[(?P<timestamp>[^\\]]+)\\]\\s+\\\"(?P<method>\\S+)\\s+(?P<path>.*?)\\s+(?P<protocol>HTTP/[0-9.]+)\\\"\\s+(?P<status>\\d{3})\\s+(?P<size>\\d+|-)$"
        }
    ]
}